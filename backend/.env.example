# ============================================================
# APPLICATION
# ============================================================

APP_NAME=CCPA Dark Pattern Auto-Auditor
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false
LOG_LEVEL=INFO

# Comma-separated, explicit frontend origins.
CORS_ORIGINS=http://localhost:3000

# ============================================================
# DATABASE
# ============================================================

# Use the PostgreSQL connection string supplied by Supabase.
# Keep credentials private; do not commit the populated .env.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_DB_HOST:5432/postgres

# ============================================================
# REDIS AND CELERY
# ============================================================

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============================================================
# TINYFISH WEB AGENT
# ============================================================

TINYFISH_API_KEY=
TINYFISH_API_BASE_URL=

# Set only after confirming the endpoint and supported options
# in the current TinyFish documentation.

# ============================================================
# GOOGLE GEMINI
# ============================================================

GEMINI_API_KEY=
GEMINI_MODEL=

# ============================================================
# SUPABASE
# ============================================================

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=private-audit-evidence

# ============================================================
# AWS S3 (OPTIONAL ALTERNATIVE TO SUPABASE STORAGE)
# ============================================================

AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================================
# AUDIT SAFETY AND RESOURCE LIMITS
# ============================================================

AUDIT_MAX_STEPS=20
AUDIT_TIMEOUT_SECONDS=180
AUDIT_MAX_CONCURRENT_RUNS=2
AUDIT_MAX_DOM_BYTES=250000
AUDIT_EVIDENCE_RETENTION_DAYS=90

# Require target validation before launching browser execution.
AUDIT_REQUIRE_TARGET_VALIDATION=true

# Never submit orders, payment details, or OTPs.
AUDIT_ALLOW_PURCHASES=false

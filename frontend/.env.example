# Server-side settings for the dashboard. Copy this file to frontend/.env.local
# (which git ignores) and fill in the values. None of these reach the browser.

# Where the backend API listens.
CCPA_API_BASE_URL=http://127.0.0.1:8000

# The same value as API_ACCESS_TOKEN in backend/.env (at least 24 characters).
API_ACCESS_TOKEN=

# The password you type to sign in to the dashboard (at least 12 characters).
DASHBOARD_PASSWORD=

# A long random string that signs the login cookie (at least 32 characters).
# Make one with: openssl rand -base64 48
SESSION_SECRET=
